# Telegram bot token from @BotFather
TG_API_KEY=123456:replace-me
# LZT Market API token (https://lolz.live/account/api)
LZT_API_KEY=replace-me

# Chat where listings are posted, optional forum topic, and the admin allowed to use /debug
CHAT_ID=-1001234567890
THREAD_ID=
ADMIN_ID=123456789

# PostgreSQL (also used by the db service in docker-compose.yml)
POSTGRES_DB=lzt_bot
POSTGRES_USER=lzt_bot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional tuning (defaults shown)
# POLL_INTERVAL_SECONDS=60
# MIN_SELLER_REVIEWS=100
# MIN_POSITIVE_PERCENT=90.0
# PRIME_MIN_AGE_YEARS=10
